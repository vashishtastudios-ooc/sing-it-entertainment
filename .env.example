# --- Database (MongoDB via Prisma) ---
# MongoDB connection string. Prisma requires the database to run as a replica set.
# Self-hosted on your VPS (after enabling a single-node replica set):
DATABASE_URL="mongodb://USER:PASSWORD@127.0.0.1:27017/singit?replicaSet=rs0&authSource=admin"
# Or MongoDB Atlas:
# DATABASE_URL="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/singit?retryWrites=true&w=majority"

# --- Admin access ---
# Password used to log into /admin. Change this in production.
ADMIN_PASSWORD=123
# Secret used to sign admin session cookies. Use a long random string.
ADMIN_SESSION_SECRET=generate-a-long-random-string

# --- Google reviews (Testimonials > Import from Google) ---
# Google Places API key with "Places API" enabled.
GOOGLE_PLACES_API_KEY=

# --- Instagram feed ---
# Long-lived Instagram Graph API access token.
INSTAGRAM_ACCESS_TOKEN=

# --- Email marketing (optional, for sending campaigns) ---
RESEND_API_KEY=
MAILCHIMP_API_KEY=
